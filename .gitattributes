# Line endings: every text file is stored with LF (git detects binary files: photos, fonts, icons).
* text=auto eol=lf
# The answers ledger is append-only: two PRs that each add lines at its end keep both, without a conflict.
docs/ANSWERS.md merge=union
# Machine-written JSON (the candidate lists and the judging results): collapsed in GitHub diffs and left out of the
# language statistics. data.json stays reviewable: it is the hand-edited source of truth (tools/datajson.py).
data/cand.json linguist-generated=true
data/fish-cand.json linguist-generated=true
fish-game.json linguist-generated=true
data/suggest.json linguist-generated=true
# core.js is its parts joined (core/*.js, tools/sync_core.py): reviewed in its parts, collapsed in GitHub diffs.
core.js linguist-generated=true
# Left out of the published site (pages.yml stages it with git archive): the docs, tests, tools, judging package and the
# repository's own config are read from the repository, never from the site (Code.gs reads raw.githubusercontent.com).
/docs/ export-ignore
/tests/ export-ignore
/tools/ export-ignore
/judging/ export-ignore
/.github/ export-ignore
/.claude/ export-ignore
# core.js's parts: the pages load core.js, built from them (tools/sync_core.py).
/core/ export-ignore
