{
  "permissions": {
    "allow": [
      "Bash(gh api -X POST repos/ppericard/coral-id-imr/pulls/*/ccr/comments/*/resolve)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(pgrep:*)",
      "Bash(node tests/run.js:*)",
      "Bash(node tests/slot.js:*)",
      "Bash(node --test:*)",
      "Bash(npx prettier --check:*)",
      "Bash(python3 tools/brief.py:*)",
      "Bash(python3 tools/night.py:*)",
      "Bash(python3 tools/effort.py:*)",
      "Bash(python3 tools/guard_bash.py:*)",
      "Bash(python3 tools/train.py --dry-run:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null && git show origin/main:tools/brief.py 2>/dev/null | python3 -I - --short 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null && git show origin/main:tools/brief.py 2>/dev/null | python3 -I - --time --night-due 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null && python3 -I -c \"$(git show origin/main:tools/guard_bash.py 2>/dev/null)\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
